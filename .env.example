# Tab feature flags — see src/lib/flags.ts and the README.
#
# Both tabs are HIDDEN unless the variable is set to "true" (or "1"). The values
# are inlined at build time, so a change needs a rebuild (Railway: a redeploy).
NEXT_PUBLIC_SHOW_SKY_TOTAL_NET_REVENUE=false
NEXT_PUBLIC_SHOW_PRIME_PAYMENTS=false

# The live tier: settle-api, read server-side by the Buybacks & Burn tab.
# Unset means exactly this value, so a checkout works with no env at all.
#
# Prefer SETTLE_API_URL — it is read first, it is server-only, and it takes
# effect on a restart. NEXT_PUBLIC_SETTLE_API_URL works too but is inlined into
# the bundle at BUILD time like the flags above, so changing it on Railway
# without rebuilding leaves the old host baked in. An empty value is ignored
# rather than taken, so an unset-but-present variable falls back to the default
# instead of producing a relative URL.
SETTLE_API_URL=https://settle-api-production.up.railway.app
#
# One exception: the Daily MSC Revenue tab renders a "read this exact published
# revision" link the reader clicks. That href is built from
# NEXT_PUBLIC_SETTLE_API_URL (or the default above) and never from
# SETTLE_API_URL, so pointing the server at an internal host neither breaks the
# link nor prints that hostname into the page.

# Refresh-time only (`pnpm refresh`), never needed by a build:
#   GITHUB_TOKEN            clone the private source repos over HTTPS instead of SSH
#   SETTLE_DR_DUNE_DIR      path to an existing settle-dr-dune checkout, skips cloning
#   SETTLEMENT_REPORTS_DIR  path to an existing settlement-reports checkout, skips cloning
#   DUNE_API_KEY            `pnpm fetch-prime-payments` only

# Provisional daily MTD estimates: enabled on Railway dev, disabled on production.
NEXT_PUBLIC_SHOW_DAILY_REVENUE=false
