{
  "name": "sky-dr-frontend",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "refresh": "node scripts/generate-data.mjs",
    "refresh:sky-total": "node scripts/generate-data.mjs --only=sky-total",
    "refresh:tmf": "node scripts/generate-data.mjs --only=tmf",
    "refresh:prime": "node scripts/generate-data.mjs --only=prime",
    "fetch-prime-payments": "node scripts/fetch-prime-payments.mjs",
    "fetch-core-spells": "node scripts/fetch-core-spells.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\" \"schema/**/*.test.mjs\""
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0"
  }
}
