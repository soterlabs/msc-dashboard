{
  "name": "sky-dr-frontend",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "refresh": "node scripts/generate-data.mjs",
    "refresh:prime": "node scripts/generate-data.mjs --prime-only",
